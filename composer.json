{
    "name": "haybea/laravel-trashcan",
    "description": "A beautiful trash management dashboard for Laravel soft deletes",
    "keywords": ["laravel", "soft-deletes", "trash", "trashcan", "admin", "dashboard"],
    "license": "MIT",
    "type": "library",
    "authors": [{"name": "Haybea", "email": "your@email.com"}],
    "homepage": "https://github.com/haybea/laravel-trashcan",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {"Haybea\\Trashcan\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Haybea\\Trashcan\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Haybea\\Trashcan\\TrashcanServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}